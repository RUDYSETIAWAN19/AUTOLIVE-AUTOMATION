<%- include('partials/header', { title: title, pageTitle: pageTitle }) %>
<button id="startBtn" class="btn btn-success me-2"><i class="fas fa-play"></i> Mulai Automation</button>
<button id="stopBtn" class="btn btn-danger"><i class="fas fa-stop"></i> Stop Automation</button>
<div id="statusMsg" class="mt-3"></div>
<script>
    document.getElementById('startBtn').onclick = async () => {
        await fetch('/workflow/start', {method:'POST'});
        document.getElementById('statusMsg').innerHTML = '<div class="alert alert-info">Automation dimulai</div>';
    };
    document.getElementById('stopBtn').onclick = async () => {
        await fetch('/workflow/stop', {method:'POST'});
        document.getElementById('statusMsg').innerHTML = '<div class="alert alert-warning">Automation dihentikan</div>';
    };
</script>
<%- include('partials/footer') %>
