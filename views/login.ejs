<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Login | AUTOLIVE AUTOMATION</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system;
            min-height: 100vh;
            background: linear-gradient(145deg, #e6f4ff 0%, #b8e1fc 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            transition: background 0.3s;
        }
        body.dark {
            background: linear-gradient(145deg, #0b1120 0%, #111827 100%);
        }
        .login-card {
            max-width: 520px;
            width: 100%;
            background: rgba(255, 255, 255, 0.96);
            border-radius: 2rem;
            box-shadow: 0 20px 35px -10px rgba(0,0,0,0.2);
            overflow: hidden;
            transition: background 0.3s;
        }
        body.dark .login-card {
            background: rgba(18, 25, 45, 0.95);
            color: #e2e8f0;
        }
        .login-header {
            padding: 20px 16px 12px;
            text-align: center;
            background: linear-gradient(105deg, #1e3a8a, #3b82f6);
            color: white;
        }
        body.dark .login-header {
            background: linear-gradient(105deg, #0f172a, #1e293b);
        }
        .main-title {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }
        .slogan {
            font-size: 0.8rem;
            opacity: 0.9;
            margin-bottom: 12px;
        }
        /* Baris kontrol: jam, tombol tema, tombol bahasa - selalu dalam satu baris */
        .header-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            margin-bottom: 10px;
        }
        .datetime {
            background: rgba(0, 0, 0, 0.3);
            padding: 4px 10px;
            border-radius: 30px;
            font-size: 0.7rem;
            white-space: nowrap;
        }
        .header-controls button {
            background: rgba(255,255,255,0.2);
            border: none;
            border-radius: 30px;
            padding: 4px 12px;
            color: white;
            font-size: 0.7rem;
            cursor: pointer;
            transition: 0.2s;
            white-space: nowrap;
        }
        .header-controls button:hover {
            background: rgba(255,255,255,0.35);
        }
        hr.divider-header {
            margin: 8px 0 0;
            border-top: 2px solid rgba(255,255,255,0.3);
        }
        .login-body {
            padding: 28px 24px 20px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: #1e293b;
        }
        body.dark .form-group label {
            color: #cbd5e1;
        }
        .form-group input {
            width: 100%;
            padding: 10px 16px;
            border-radius: 60px;
            border: 1px solid #cbd5e1;
            background: white;
            font-size: 0.9rem;
            transition: 0.2s;
        }
        body.dark .form-group input {
            background: #1e293b;
            border-color: #475569;
            color: #f1f5f9;
        }
        .form-group input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.3);
        }
        .btn-login {
            background: linear-gradient(95deg, #2563eb, #1d4ed8);
            border: none;
            border-radius: 60px;
            padding: 10px 20px;
            font-weight: 600;
            font-size: 1rem;
            color: white;
            width: 160px;
            margin: 10px auto 0;
            display: block;
            transition: 0.2s;
        }
        .btn-login:hover {
            transform: scale(1.02);
            background: linear-gradient(95deg, #1d4ed8, #1e3a8a);
        }
        .register-link {
            text-align: center;
            margin-top: 20px;
            font-size: 0.85rem;
        }
        .register-link a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }
        body.dark .register-link a {
            color: #60a5fa;
        }
        .version-credit {
            text-align: center;
            font-size: 0.7rem;
            color: #64748b;
            margin-top: 20px;
            padding-top: 12px;
            border-top: 1px solid #e2e8f0;
        }
        body.dark .version-credit {
            border-top-color: #334155;
            color: #94a3b8;
        }
        hr.divider-body {
            margin: 16px 24px;
            border-top: 1px solid #cbd5e1;
        }
        body.dark hr.divider-body {
            border-top-color: #334155;
        }
        .footer-rules {
            padding: 0 24px 24px;
            font-size: 0.7rem;
            color: #334155;
        }
        body.dark .footer-rules {
            color: #cbd5e6;
        }
        .footer-rules p {
            margin-bottom: 10px;
            text-align: center;
        }
        .footer-rules ul {
            padding-left: 20px;
            margin-bottom: 12px;
        }
        .footer-rules li {
            margin-bottom: 6px;
            text-align: left;
        }
        .copyright {
            text-align: center;
            margin-top: 12px;
            font-size: 0.65rem;
        }
        .alert {
            border-radius: 60px;
            font-size: 0.8rem;
            margin-bottom: 20px;
        }
        /* Responsive: jika layar terlalu kecil, perkecil font dan padding */
        @media (max-width: 480px) {
            .login-body { padding: 20px 16px; }
            .footer-rules { padding: 0 16px 20px; }
            hr.divider-body { margin: 16px 16px; }
            .datetime { font-size: 0.6rem; padding: 3px 8px; }
            .header-controls button { font-size: 0.65rem; padding: 3px 10px; }
            .main-title { font-size: 1.5rem; }
            .slogan { font-size: 0.7rem; }
        }
        /* Untuk layar sangat sempit (max 360px) tetap satu baris dengan gap kecil */
        @media (max-width: 380px) {
            .header-controls { gap: 6px; }
            .datetime { font-size: 0.55rem; }
            .header-controls button { font-size: 0.6rem; padding: 3px 8px; }
        }
    </style>
</head>
<body class="<%= theme === 'dark' ? 'dark' : '' %>">
<div class="login-card">
    <div class="login-header">
        <div class="main-title">AUTOLIVE AUTOMATION</div>
        <div class="slogan"><%= t('slogan') %></div>
        <div class="header-controls">
            <span class="datetime" id="liveDateTime"></span>
            <button id="themeToggleBtn"><i class="fas <%= theme === 'dark' ? 'fa-sun' : 'fa-moon' %>"></i> <%= theme === 'dark' ? 'Light' : 'Dark' %></button>
            <button id="langToggleBtn"><i class="fas fa-globe"></i> <%= currentLang === 'id' ? 'ID' : 'EN' %></button>
        </div>
        <hr class="divider-header">
    </div>

    <div class="login-body">
        <% if (error) { %>
            <div class="alert alert-danger text-center"><%= error %></div>
        <% } %>
        <form method="POST" action="/login">
            <div class="form-group">
                <label><%= t('email') %> :</label>
                <input type="email" name="email" placeholder="nama@email.com" required autofocus>
            </div>
            <div class="form-group">
                <label><%= t('password') %> :</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn-login"><%= t('loginBtn') %></button>
        </form>
        <div class="register-link">
            <%= t('noAccount') %> <a href="/register"><%= t('register') %></a>
        </div>
        <div class="version-credit">
            <div><%= t('version') %></div>
            <div><%= t('credit') %></div>
        </div>
    </div>

    <hr class="divider-body">

    <div class="footer-rules">
        <p><strong><%= t('desc').split('.')[0] %></strong><br><%= t('desc') %></p>
        <ul>
            <% t('rules').forEach(rule => { %>
                <li><%= rule %></li>
            <% }) %>
        </ul>
        <div class="copyright"><%= t('footer') %></div>
    </div>
</div>

<script>
    function updateDateTime() {
        const now = new Date();
        const lang = '<%= currentLang %>';
        let formatted;
        if (lang === 'id') {
            // Format ringkas untuk mobile: "9 Apr 2026 14:07"
            formatted = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + 
                        ' ' + now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        } else {
            formatted = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) +
                        ' ' + now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
        }
        document.getElementById('liveDateTime').innerText = formatted;
    }
    updateDateTime();
    setInterval(updateDateTime, 60000);

    // Theme toggle
    const themeBtn = document.getElementById('themeToggleBtn');
    themeBtn.addEventListener('click', async () => {
        const isDark = document.body.classList.contains('dark');
        const newTheme = isDark ? 'light' : 'dark';
        const res = await fetch('/set-theme', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ theme: newTheme })
        });
        if (res.ok) {
            if (newTheme === 'dark') {
                document.body.classList.add('dark');
                document.body.classList.remove('light');
                themeBtn.innerHTML = '<i class="fas fa-sun"></i> Light';
            } else {
                document.body.classList.add('light');
                document.body.classList.remove('dark');
                themeBtn.innerHTML = '<i class="fas fa-moon"></i> Dark';
            }
        }
    });

    // Language toggle tanpa dropdown
    const langBtn = document.getElementById('langToggleBtn');
    langBtn.addEventListener('click', () => {
        const currentLang = '<%= currentLang %>';
        const newLang = currentLang === 'id' ? 'en' : 'id';
        window.location.href = '/set-lang/' + newLang;
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
